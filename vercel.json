{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "keith-portfolio": {
      "root": "artifacts/keith-portfolio",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/favicon.ico",
          "destination": "/favicon.svg"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/__mockup/(.*)",
      "destination": {
        "service": "mockup-sandbox"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "keith-portfolio"
      }
    }
  ]
}